# Copie para server/.env e preencha. O servidor não sobe se faltar alguma variável.

# Postgres de verdade:  postgres://usuario:senha@host:5432/banco?sslmode=require
# Postgres embutido (dev, sem instalar nada):  pglite:./dados/pglite
DATABASE_URL=

# Segredos com pelo menos 32 caracteres, diferentes entre si.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HMAC_PARTIDA_SECRET=
TOKEN_PEPPER=

# Origens exatas do app, separadas por vírgula (nada de *).
CORS_ORIGENS=

# Opcionais
PORT=8787
HOST=127.0.0.1
