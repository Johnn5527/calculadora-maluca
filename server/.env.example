# Copie para server/.env e preencha. O servidor não sobe se faltar alguma variável.

# Postgres de verdade:  postgres://usuario:senha@host:5432/banco?sslmode=require
# Postgres embutido (dev, sem instalar nada):  pglite:./dados/pglite
DATABASE_URL=

# Segredos com pelo menos 32 caracteres, diferentes entre si.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HMAC_PARTIDA_SECRET=
TOKEN_PEPPER=

# Origens exatas do app, separadas por vírgula (nada de *).
CORS_ORIGENS=

# Opcionais
PORT=8787
HOST=127.0.0.1

# Produção (a hospedagem costuma definir estas no painel, não neste arquivo):
# NODE_ENV=production   -> exige Postgres de verdade e origens https; não aplica migrations sozinho
# HOST=0.0.0.0          -> dentro do container (a imagem Docker já define)
# TRUST_PROXY=1         -> quantos proxies ficam na frente (Render/Fly/Cloudflare = 1); 0 se ninguém
NODE_ENV=
TRUST_PROXY=0
